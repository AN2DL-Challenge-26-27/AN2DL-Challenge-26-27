# Project settings for this machine. Copy to .env (ignored by git) and adjust.
# Relative paths are resolved from the project directory.
# Experiment parameters do NOT go here: they live in configs/experiments/*.env (see configs/README.md).

# Data and outputs
SPAGHETTI_DATA_DIR=data/raw                    # raw Kaggle data or an extracted Drive package
SPAGHETTI_OUTPUT_DIR=outputs/eda
SPAGHETTI_MANIFEST_DIR=manifests               # tracked manifests and folds
SPAGHETTI_PREPROCESS_DIR=outputs/preprocessing # local review sheets
SPAGHETTI_RUNS_DIR=outputs/runs                # where training runs and results.csv are written

# Workers and seed
SPAGHETTI_EDA_WORKERS=8                        # threads for eda / preprocess
SPAGHETTI_EDA_SEED=42
SPAGHETTI_NUM_WORKERS=4                        # DataLoader workers for training (Colab: 2)

# Optional. If needed, set KAGGLE_API_TOKEN only in your local .env.
