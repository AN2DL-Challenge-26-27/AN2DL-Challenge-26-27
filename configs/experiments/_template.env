# Copy this file to configs/experiments/<run name>.env; the run is named after the file.
# Only set what differs from the defaults (python -m spaghetti1 train --dry-run shows them all).
# Check the result before training:  python -m spaghetti1 train --config <file> --dry-run
BASE=../recipes/research_v2.env   # optional: inherit a shared recipe
DESCRIPTION=What this run tests
MODEL=convnext_tiny               # preset (python -m spaghetti1 list-models) or any timm name
FOLD=0
EPOCHS=30
# IMAGE_SIZE=288
# LR=3e-4
# LAYER_DECAY=0.85
