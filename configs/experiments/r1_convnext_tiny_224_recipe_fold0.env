# R1 (docs/10): does the research recipe alone beat E1a (0.843)?
BASE=../recipes/research_v2.env
DESCRIPTION=ConvNeXt-Tiny 224 with the research recipe
MODEL=convnext_tiny
EPOCHS=30
LR=3e-4                     # head LR; earlier blocks get less through layer decay
LAYER_DECAY=0.85            # ConvNeXt has 20 LR levels in timm, so 0.85 (lowest level ~4.5%)
