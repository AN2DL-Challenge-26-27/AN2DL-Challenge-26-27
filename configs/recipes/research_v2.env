# Training recipe from the research review (docs/10): shared by R1, R2, and later runs.
# Experiment files inherit it with  BASE=../recipes/research_v2.env  and set MODEL etc.
LABEL_POLICY=drop_copies
CLASS_WEIGHT_POWER=0        # unweighted loss: weighted F1 favours the large classes
LABEL_SMOOTHING=0           # replaced by MixUp
MIXUP_ALPHA=0.3             # MixUp only, never CutMix (galaxies are radially symmetric)
MIXUP_PROB=0.5
MIXUP_OFF_EPOCHS=5          # last 5 epochs without MixUp
EMA_DECAY=0.998             # score and save the moving average of the weights
DROP_PATH_RATE=0.25
RESUME=true                 # re-running the command continues an interrupted run
