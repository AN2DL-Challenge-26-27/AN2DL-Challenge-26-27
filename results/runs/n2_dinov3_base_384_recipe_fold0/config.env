RUN_NAME=n2_dinov3_base_384_recipe_fold0  # config file name
DESCRIPTION=DINOv3 ViT-B/16 at 384 px with the research recipe  # configs/experiments/n2_dinov3_base_384_recipe_fold0.env
MODEL=dinov3_base  # configs/experiments/n2_dinov3_base_384_recipe_fold0.env
FOLD=0  # default
SEED=42  # default
EPOCHS=25  # configs/experiments/n2_dinov3_base_384_recipe_fold0.env
BATCH_SIZE=8  # preset dinov3_base
ACCUMULATION_STEPS=4  # preset dinov3_base
LR=0.0002  # preset dinov3_base
HEAD_LR_MULTIPLIER=10.0  # default
LAYER_DECAY=0.75  # preset dinov3_base
WEIGHT_DECAY=0.05  # default
WARMUP_EPOCHS=1.0  # default
DROP_PATH_RATE=0.25  # configs/recipes/research_v2.env
GRAD_CHECKPOINTING=true  # preset dinov3_base
EMA_DECAY=0.998  # configs/recipes/research_v2.env
LABEL_SMOOTHING=0.0  # configs/recipes/research_v2.env
CLASS_WEIGHT_POWER=0.0  # configs/recipes/research_v2.env
