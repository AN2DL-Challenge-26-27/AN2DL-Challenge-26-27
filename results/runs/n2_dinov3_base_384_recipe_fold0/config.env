MIXUP_ALPHA=0.3  # configs/recipes/research_v2.env
MIXUP_PROB=0.5  # configs/recipes/research_v2.env
MIXUP_OFF_EPOCHS=5  # configs/recipes/research_v2.env
IMAGE_SIZE=384  # preset dinov3_base
AUGMENT=true  # default
BACKGROUND_NORMALIZE=false  # default
DENOISE=none  # default
NUM_WORKERS=4  # default
PRECISION=auto  # default
TTA=true  # default
PREDICT_TEST=true  # command line
TEST_TTA=false  # command line
RESUME=true  # configs/recipes/research_v2.env
LIMIT_BATCHES=0  # default
